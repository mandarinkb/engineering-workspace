meta {
  name: Get updated schedule
  type: http
  seq: 11
}

get {
  url: {{baseUrl}}/schedules/{{scheduleId}}
  body: none
  auth: none
}

script:post-response {
  // เก็บชื่อที่อ่านได้ไว้ส่งกลับใน PUT ของ request ถัดไป (round trip แบบที่ฟอร์มแก้ไขทำ)
  bru.setVar("readWorkflowName", res.getBody().workflow_name);
}

tests {
  test("workflow_name ยังเป็นชื่อที่ตั้ง ไม่ใช่ Execute หลัง PUT", function () {
    expect(res.getBody().workflow_name).to.equal("bruno-schedule");
  });

  test("Catch-up Window ที่แก้เป็น 120 ยังอยู่ใน Temporal Schedule", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().catchup_window_seconds).to.equal(120);
  });

  test("steps ที่อ่านกลับจาก Temporal Schedule เป็นค่าที่แก้แล้ว", function () {
    const s = res.getBody();
    expect(s.steps).to.have.lengthOf(1);
    expect(s.steps[0].bot_name).to.equal("http-status-checker");
    expect(s.steps[0].config.url).to.equal("http://bop-api:8080/readyz");
  });
}
