meta {
  name: Get schedule
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/schedules/{{scheduleId}}
  body: none
  auth: none
}

tests {
  test("ได้ steps ตามที่สร้าง (ถอดรหัสจาก Temporal Schedule)", function () {
    expect(res.getStatus()).to.equal(200);
    const s = res.getBody();
    expect(s.steps).to.have.lengthOf(1);
    expect(s.steps[0].bot_name).to.equal("http-status-checker");
    expect(s.steps[0].config.url).to.equal("http://bop-api:8080/healthz");
  });

  test("Catch-up Window ที่ตั้งอยู่จริงใน Temporal Schedule เป็น 3600", function () {
    expect(res.getBody().catchup_window_seconds).to.equal(3600);
  });
}
