meta {
  name: Update schedule with the workflow_name read from GET
  type: http
  seq: 12
}

put {
  url: {{baseUrl}}/schedules/{{scheduleId}}
  body: json
  auth: none
}

body:json {
  {
    "workflow_name": "{{readWorkflowName}}",
    "steps": [
      {"bot_name": "http-status-checker", "config": {"url": "http://bop-api:8080/readyz"}}
    ],
    "spec": {"interval_seconds": 7200},
    "catchup_window_seconds": 120
  }
}

tests {
  test("ตอบ 200 และชื่อที่ส่งกลับเท่าเดิม", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().workflow_name).to.equal("bruno-schedule");
  });
}
