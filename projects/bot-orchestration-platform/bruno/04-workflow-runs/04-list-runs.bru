meta {
  name: List workflow runs
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/workflow-runs
  body: none
  auth: none
}

tests {
  test("รายการมี Workflow Run ที่เพิ่งสร้าง", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().map((r) => r.workflow_id)).to.include(bru.getVar("workflowId"));
  });
}
