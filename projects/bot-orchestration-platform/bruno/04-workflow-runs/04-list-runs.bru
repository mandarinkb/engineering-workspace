meta {
  name: List workflow runs
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/workflow-runs
  body: none
  auth: none
}

tests {
  test("ตอบเป็น object ที่มี runs และ next_page_token", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().runs).to.be.an("array");
    expect(res.getBody().next_page_token).to.be.a("string");
  });

  test("ไม่ระบุ page_size ได้ไม่เกิน 50 ตัว", function () {
    expect(res.getBody().runs.length).to.be.at.most(50);
  });

  test("หน้าแรกมี Workflow Run ที่เพิ่งสร้าง (ใหม่สุดก่อน)", function () {
    expect(res.getBody().runs.map((r) => r.workflow_id)).to.include(bru.getVar("workflowId"));
  });
}
