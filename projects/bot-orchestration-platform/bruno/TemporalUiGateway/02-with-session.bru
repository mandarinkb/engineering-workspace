meta {
  name: Temporal UI with session
  type: http
  seq: 2
}

get {
  url: {{gatewayUrl}}/
  body: none
  auth: none
}

script:pre-request {
  // gateway ตอบ 302 เมื่อไม่ผ่าน — ห้ามตาม redirect ไม่งั้นจะเห็นหน้า login ของ dashboard แทน
  req.setMaxRedirects(0);
}

tests {
  test("login แล้วได้ 200 จาก Temporal UI ไม่ถูก redirect", function () {
    expect(res.getStatus()).to.equal(200);
  });
}
