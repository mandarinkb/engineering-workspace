meta {
  name: Temporal UI without cookie
  type: http
  seq: 4
}

get {
  url: {{gatewayUrl}}/
  body: none
  auth: none
}

headers {
  Cookie:
}

script:pre-request {
  // ต้องเห็น 302 เอง จึงไม่ตาม redirect
  req.setMaxRedirects(0);
}

tests {
  test("ไม่มี cookie ได้ 302", function () {
    expect(res.getStatus()).to.equal(302);
  });
  test("Location ชี้ไปหน้า /login ของ dashboard", function () {
    expect(res.getHeader("location")).to.match(/:3000\/login$/);
  });
}
