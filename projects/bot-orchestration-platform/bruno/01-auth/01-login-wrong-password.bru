meta {
  name: Login wrong password
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/login
  body: json
  auth: none
}

body:json {
  {"username": "{{username}}", "password": "definitely-wrong"}
}

tests {
  test("ตอบ 401 เมื่อ password ผิด", function () {
    expect(res.getStatus()).to.equal(401);
  });
}
